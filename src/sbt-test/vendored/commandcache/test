# The recipe-keyed command cache, route by route. Each input change rebuilds and links the new content; an unchanged
# recipe, the test link, and a refactor leaving the recipe equal are hits. A hit restores the archive but not answer.o.
> removeStaging
> Compile/snxConfig
> expectBuilt main
> expectHolds snx-variant-1 snx-extra-1 snx-note-1 snx-overlay-1

> removeStaging
> Compile/snxConfig
> expectCached

# The test link of the same recipe shares main's archive.
> removeStaging
> Test/snxConfig
> expectTestCached

# The recipe's own text, edited in build.sbt.
$ copy-file changes/variant-2.sbt build.sbt
> reload
> removeStaging
> Compile/snxConfig
> expectBuilt main
> expectHolds snx-variant-2

# A helper in another file of the build definition.
$ copy-file changes/Warnings.scala project/Warnings.scala
> reload
> removeStaging
> Compile/snxConfig
> expectBuilt main

