#!/usr/bin/env bash
# Creates the release tag v<version> on the current commit, signed with your own OpenPGP key, and
# pushes it to the main repository; that push alone starts the release. The tree must be clean, on
# a branch tracking the main repository, with nothing to push or pull.
#
#   ./release <version>        <version> is MAJOR.MINOR.PATCH with an optional -milestone.N, -m.N,
#                              -alpha.N, -beta.N or -rc.N
#
# Runs under bash 3.2, macOS's own, and later; needs git.
#
# Exit: 0 tagged and pushed; 1 a check or a git step failed; 2 usage.
set -euo pipefail

: "${MAIN_REPO_OWNER:=shuwariafrica}"
: "${MAIN_REPO_NAME:=sbt-snx}"
readonly SEMVER='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(milestone|m|alpha|beta|rc)\.[1-9][0-9]*)?$'

fail() {
  printf 'release: %s\n' "$1" >&2
  exit 1
}

usage() {
  printf 'usage: release <version>   (for example 1.2.3 or 1.2.3-rc.1)\n' >&2
  exit 2
}

main() {
  command -v git >/dev/null 2>&1 || fail "git is not installed"
  (($# == 1)) || usage
  [[ $1 == -h || $1 == --help ]] && usage
  local version=$1 tag="v$1"
  [[ ${version} =~ ${SEMVER} ]] || fail "${version} is not a release version"

  local status
  status=$(git status --porcelain)
  [[ -z ${status} ]] || fail "the working tree has uncommitted changes"

  # The main repository may be configured under any remote name, by HTTPS or SSH, and in any letter
  # case, as GitHub matches names. The configured URL is read, not `get-url`'s, which a
  # url.<base>.insteadOf rule rewrites.
  local main_remote='' remotes remote urls url slug
  slug=$(tr '[:upper:]' '[:lower:]' <<<"${MAIN_REPO_OWNER}/${MAIN_REPO_NAME}")
  remotes=$(git remote)
  while IFS= read -r remote && [[ -z ${main_remote} ]]; do
    [[ -n ${remote} ]] || continue
    # A remote with no URL configured cannot be the main repository.
    urls=$(git config --get-all "remote.${remote}.url") || continue
    while IFS= read -r url; do
      url=$(tr '[:upper:]' '[:lower:]' <<<"${url}")
      case ${url} in
        "https://github.com/${slug}" | "https://github.com/${slug}.git" | "git@github.com:${slug}" | "git@github.com:${slug}.git" | \
          "ssh://git@github.com/${slug}" | "ssh://git@github.com/${slug}.git")
          main_remote=${remote}
          ;;
        *) ;;
      esac
    done <<<"${urls}"
  done <<<"${remotes}"
  [[ -n ${main_remote} ]] || fail "no remote points to ${MAIN_REPO_OWNER}/${MAIN_REPO_NAME}"

  local branch upstream
  branch=$(git rev-parse --abbrev-ref HEAD)
  [[ ${branch} != HEAD ]] || fail "HEAD is detached"
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}') || fail "${branch} has no upstream"
  [[ ${upstream%%/*} == "${main_remote}" ]] || fail "${branch} tracks ${upstream}, not ${main_remote}"

  git fetch --prune --tags "${main_remote}"
  local counts ahead behind
  counts=$(git rev-list --left-right --count 'HEAD...@{u}')
  read -r ahead behind <<<"${counts}"
  ((behind == 0)) || fail "${branch} is ${behind} commit(s) behind ${upstream}"
  ((ahead == 0)) || fail "${branch} has ${ahead} unpushed commit(s)"

  # --tags --verify, so a branch or other ref of the same name cannot pass for the tag.
  ! git show-ref --tags --verify --quiet "refs/tags/${tag}" || fail "${tag} already exists locally"
  local remote_tag
  remote_tag=$(git ls-remote --tags "${main_remote}" "refs/tags/${tag}")
  [[ -z ${remote_tag} ]] || fail "${tag} already exists on ${main_remote}"

  # --sign fails without a configured key, which is the intended behaviour.
  git tag --sign --annotate "${tag}" --message "Release ${tag}"
  git push "${main_remote}" "refs/tags/${tag}" ||
    fail "${tag} is signed here but not on ${main_remote}: push it with git push ${main_remote} refs/tags/${tag}, or remove it with git tag -d ${tag}"
  printf 'release: pushed %s to %s\n' "${tag}" "${main_remote}"
}

if ! (return 0 2>/dev/null); then
  main "$@"
  exit
fi
